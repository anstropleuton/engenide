{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_COLOR_DIAGNOSTICS": "ON"
      }
    },

    {
      "name": "cfg-debug",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "cfg-release",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "tidy",
      "hidden": true,
      "cacheVariables": { "ENABLE_CLANG_TIDY": "ON" },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "enableClangTidyCodeAnalysis": true
        }
      }
    },

    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": ["base", "cfg-debug"]
    },
    {
      "name": "debug-tidy",
      "displayName": "Debug + clang-tidy",
      "inherits": ["base", "cfg-debug", "tidy"]
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": ["base", "cfg-release"]
    },

    {
      "name": "tc-win-msvc",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "tc-win-clang-cl",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "tc-win-clang",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "tc-win-mingw",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic"
      }
    },
    {
      "name": "tc-linux-gcc",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "tc-linux-clang",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },

    {
      "name": "win-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "inherits": ["tc-win-msvc", "cfg-debug"]
    },
    {
      "name": "win-msvc-release",
      "displayName": "Windows MSVC Release",
      "inherits": ["tc-win-msvc", "cfg-release"]
    },

    {
      "name": "win-clang-cl-debug",
      "displayName": "Windows clang-cl Debug",
      "inherits": ["tc-win-clang-cl", "cfg-debug"]
    },
    {
      "name": "win-clang-cl-release",
      "displayName": "Windows clang-cl Release",
      "inherits": ["tc-win-clang-cl", "cfg-release"]
    },
    {
      "name": "win-clang-cl-debug-tidy",
      "displayName": "Windows clang-cl Debug + clang-tidy",
      "inherits": ["tc-win-clang-cl", "cfg-debug", "tidy"]
    },

    {
      "name": "win-clang-debug",
      "displayName": "Windows Clang Debug",
      "inherits": ["tc-win-clang", "cfg-debug"]
    },
    {
      "name": "win-clang-release",
      "displayName": "Windows Clang Release",
      "inherits": ["tc-win-clang", "cfg-release"]
    },
    {
      "name": "win-clang-debug-tidy",
      "displayName": "Windows Clang Debug + clang-tidy",
      "inherits": ["tc-win-clang", "cfg-debug", "tidy"]
    },

    {
      "name": "win-mingw-debug",
      "displayName": "Windows MinGW Debug",
      "inherits": ["tc-win-mingw", "cfg-debug"]
    },
    {
      "name": "win-mingw-release",
      "displayName": "Windows MinGW Release",
      "inherits": ["tc-win-mingw", "cfg-release"]
    },

    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug",
      "inherits": ["tc-linux-gcc", "cfg-debug"]
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux GCC Release",
      "inherits": ["tc-linux-gcc", "cfg-release"]
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug",
      "inherits": ["tc-linux-clang", "cfg-debug"]
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux Clang Release",
      "inherits": ["tc-linux-clang", "cfg-release"]
    },
    {
      "name": "linux-clang-debug-tidy",
      "displayName": "Linux Clang Debug + clang-tidy",
      "inherits": ["tc-linux-clang", "cfg-debug", "tidy"]
    }
  ],
